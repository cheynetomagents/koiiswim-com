# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Shopify App credentials (from dev.shopify.com Partners Dashboard)
SHOPIFY_API_KEY=0abb9d59730f67c95332fa1815155950
SHOPIFY_API_SECRET=<your_app_secret_from_partners_dashboard>

# URL of the staging / dev store (e.g. koiiswim-dev.myshopify.com)
SHOPIFY_FLAG_STORE=<your-dev-store>.myshopify.com

# Scopes requested by the app
SCOPES=write_themes,read_themes,write_products,read_products

# Theme access password (generated in Shopify Admin > Apps > Theme Access)
SHOPIFY_CLI_THEME_TOKEN=<your_theme_access_password>

# ID of the staging theme to push to
SHOPIFY_STAGING_THEME_ID=<theme_id>

# Host for the app server (set automatically by Shopify CLI in dev)
HOST=
